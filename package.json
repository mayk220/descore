{
  "name": "descore-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode e2e --port 4173 --strictPort",
    "build": "vite build",
    "test:e2e": "cypress run --e2e",
    "test:e2e:open": "cypress open --e2e",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.{js,jsx}"
    ],
    "exclude": [
      "src/main.jsx"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "cypress": "^16.4.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.0"
  }
}
